# Database Credentials
DB_ROOT_PASSWORD=your_super_secure_postgres_root_password_32char
AGENT_DB_PASS=agent_service_secure_password_32char
NANGO_DB_PASS=nango_vault_secure_password_32char

# Nango Encryption Key (Must be exactly 32 hex characters for AES-256-GCM)
NANGO_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLM API Keys
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# Third-Party Connectors (e.g. Notion Public Integration)
NOTION_CLIENT_ID=your_notion_oauth_client_id
NOTION_CLIENT_SECRET=your_notion_oauth_client_secret

# Firebase Admin Configuration
FIREBASE_CONFIG_PATH=/secrets/firebase-service-account.json
