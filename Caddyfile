# Reverse proxy for Agent Synapse Microservice (SSE Streaming)
agent.latyr.com {
    reverse_proxy agent-microservice:8000 {
        flush_interval -1 # Disable response buffering for immediate SSE streaming
    }
}

# Reverse proxy for Nango Connection Gateway (OAuth Callbacks)
auth.latyr.com {
    reverse_proxy nango:3003
}
